############################################################
# PYTHON / DJANGO
############################################################

# Byte-compiled / optimized / DLL files
__pycache__/
*/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
env/
venv/
ENV/
.venv/
.env
*.env

data/*.csv
data/*.ipynb
AMELIORATIONS_RECOMMANDATIONS.md
GUIDE_ENDPOINTS_RECOMMANDATIONS.md
*.md

# Django stuff
db.sqlite3
db.sqlite3-journal

# Static & media files (si générées automatiquement)
staticfiles/
media/
static/
build/

# Django migrations (générées automatiquement)
*/migrations/*.py
!*/migrations/__init__.py

